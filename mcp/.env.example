# Copy to .env and fill in. Never commit the real file.
# The service role key bypasses row level security entirely — treat it like a password
# to the whole scoreboard.
SUPABASE_URL=https://obfekzpumitnybxfgnol.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Writes are off unless this is exactly "1".
GSTEAM_ALLOW_WRITES=1

# Who to credit for a write when the agent does not say who asked.
GSTEAM_ACTOR_EMAIL=

# "1" reports what a write would do without doing it.
GSTEAM_DRY_RUN=
